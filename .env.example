# ==============================================================================
# PERCEPTGUARD AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this template to '.env' for local development or customize in deployment.
# NEVER commit your actual '.env' file or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT PROFILE
# ------------------------------------------------------------------------------
# Profile: 'development' | 'testing' | 'production'
# In 'production': DEBUG must be False, SECRET_KEY must be >= 16 chars (non-default),
# and wildcard '*' CORS origins or allowed hosts are strictly rejected.
APP_ENV=development
APP_NAME="PerceptGuard AI"
APP_VERSION=1.0.0-preview
DEBUG=true

# ------------------------------------------------------------------------------
# 2. BACKEND API SERVICE (FastAPI)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_RELOAD=false
API_WORKERS=1
API_TIMEOUT_SECONDS=30.0

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins. Wildcards (*) are forbidden in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# In production, generate a secure 256-bit key: openssl rand -hex 32
# Default key below is PERMITTED ONLY for development/testing!
SECRET_KEY=dev-insecure-secret-key-perceptguard-2026
ALLOWED_HOSTS=*
RATE_LIMIT_PER_MINUTE=120
ENABLE_CSRF=false

# ------------------------------------------------------------------------------
# 4. LOGGING & TELEMETRY
# ------------------------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_JSON=false
# LOG_FILE=logs/perceptguard.log

# ------------------------------------------------------------------------------
# 5. ML INFERENCE & MODEL CHECKPOINTS
# ------------------------------------------------------------------------------
# Device: 'cpu' | 'cuda'
DEVICE=cpu
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
# LSTM_MODEL_PATH=models/forecasting/lstm/model.pt
# BASELINE_MODEL_PATH=models/forecasting/baseline/model.pt

# ------------------------------------------------------------------------------
# 6. VIDEO PROCESSING & FORECASTING SEQUENCE
# ------------------------------------------------------------------------------
TRACKER_TYPE=bytetrack
HISTORICAL_SEQUENCE_LENGTH=10
FORECAST_HORIZONS=1,3,5
RELIABILITY_IOU_CORRECT_THRESHOLD=0.50
RELIABILITY_IOU_HIGH_THRESHOLD=0.70

# ------------------------------------------------------------------------------
# 7. FRONTEND DASHBOARD (React + TypeScript Cockpit)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 8. LEGACY IN-PROCESS INSPECTOR (Streamlit)
# ------------------------------------------------------------------------------
STREAMLIT_HOST=localhost
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000
DASHBOARD_REQUEST_TIMEOUT_SECONDS=10.0
DASHBOARD_AUTO_REFRESH_SECONDS=5
TELEMETRY_FRESHNESS_TTL_SECONDS=30
CALIBRATION_STATUS_LABEL="PROVISIONAL CALIBRATION"
