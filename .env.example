# PerceptGuard-AI Configuration
# Copy this file to .env and adjust variables as appropriate for your local environment

# Compute Device ('cpu' or 'cuda')
DEVICE=cpu

# Hardware Acceleration / Worker Threads
NUM_WORKERS=2

# Directory Paths
DATASET_RAW_DIR=datasets/raw
DATASET_PROCESSED_DIR=datasets/processed
MODELS_DIR=models
OUTPUTS_DIR=outputs

# Detection & Tracking Configuration
YOLO_MODEL=yolov8n.pt
TRACKER_TYPE=bytetrack
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# Reliability Forecasting Sequence Parameters
HISTORICAL_SEQUENCE_LENGTH=10
FORECAST_HORIZONS=1,3,5

# Logging & Monitoring
LOG_LEVEL=INFO
STREAMLIT_PORT=8501

